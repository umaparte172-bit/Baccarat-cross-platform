{
  "name": "trade247",
  "version": "0.1.0",
  "private": true,
  "description": "TRADE247-V1: local baccarat strategy bot (paper trading first)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node tools/build-app.mjs",
    "smoke": "node tools/smoke-app.mjs",
    "release": "node tools/build-app.mjs && node tools/assemble-release.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
